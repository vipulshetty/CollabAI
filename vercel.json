  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "env": {
    "NEXT_PUBLIC_SOCKET_URL": "https://collabai-frontend-b3dmgdaxj-vipulshettys-projects.vercel.app",
    "NEXTAUTH_URL": "https://collabai-frontend-b3dmgdaxj-vipulshettys-projects.vercel.app"
  },
  "routes": [
    {
      "src": "/(.*)",
