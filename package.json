{
  "name": "collab-ai",
  "version": "1.0.0",
  "description": "AI-powered video collaboration platform with GDPR compliance",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "npm run start:backend",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm start",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "clean": "rm -rf frontend/node_modules backend/node_modules frontend/.next backend/dist",
    "clean:win": "rmdir /s /q frontend\\node_modules backend\\node_modules frontend\\.next backend\\dist",
    "deploy:frontend": "cd frontend && npm run build && vercel --prod",
    "deploy:backend": "cd backend && npm run build"
  },
  "keywords": ["video-call", "collaboration", "ai", "gdpr", "webrtc", "nextjs", "socket.io"],
  "author": "CollabAI Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
